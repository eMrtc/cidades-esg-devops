# ============================================================
# Variáveis de Ambiente - Cidades ESG Inteligentes Backend
# ============================================================

# Conexão MongoDB
MONGO_URI=mongodb://mongodb:27017/cidades_esg

# Configurações de Segurança JWT (Mínimo 256 bits / 32 caracteres)
JWT_SECRET=chaveSuperSecretaCidadesESGDevOps2026Minimo32Caracteres
JWT_EXPIRATION_MS=86400000

# Chave API Google Gemini (Opcional - Recursos IA)
GEMINI_API_KEY=

# Porta da Aplicação
PORT=8080
SPRING_PROFILES_ACTIVE=prod
